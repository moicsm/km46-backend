range":"78","text":"79"},"Replace with `new MedusaError(MedusaError.Types.UNEXPECTED_STATE, ...)` (pick the appropriate `MedusaError.Types.*`).",{"type":"77"},{"range":"80","text":"81"},"MedusaError.Types.UNEXPECTED_STATE",[1632,3550],", MedusaError } from \"@medusajs/framework/utils\";\r\nimport {\r\n  batchVariantImagesWorkflow,\r\n  createCollectionsWorkflow,\r\n  createInventoryLevelsWorkflow,\r\n  createProductCategoriesWorkflow,\r\n  createProductsWorkflow,\r\n  createProductTagsWorkflow,\r\n  createProductTypesWorkflow,\r\n  deleteProductsWorkflow,\r\n} from \"@medusajs/medusa/core-flows\";\r\n\r\nconst SOURCE = \"catalogo-km43\";\r\n\r\ntype CatalogVariant = { options: Record<string, string>; stock: number; images: string[] };\r\ntype CatalogProduct = {\r\n  handle: string;\r\n  title: string;\r\n  collection: string | null;\r\n  category: string | null;\r\n  tag: string | null;\r\n  price: number | null;\r\n  description: string;\r\n  details: string;\r\n  care: string;\r\n  options: Record<string, string[]>;\r\n  colors: Record<string, string>;\r\n  variants: CatalogVariant[];\r\n  images: string[];\r\n  thumbnail: string | null;\r\n};\r\ntype Catalog = {\r\n  fuente: string;\r\n  generado: string;\r\n  tipo?: string;\r\n  colecciones: { title: string; handle: string }[];\r\n  productos: CatalogProduct[];\r\n};\r\n\r\nconst sku = (...parts: string[]) =>\r\n  parts\r\n    .join(\"-\")\r\n    .normalize(\"NFD\")\r\n    .replace(/\\p{M}/gu, \"\") // quita acentos (marcas combinantes tras NFD)\r\n    .toUpperCase()\r\n    .replace(/[^A-Z0-9]+/g, \"-\")\r\n    .replace(/(^-|-$)/g, \"\");\r\n\r\nfunction loadCatalog(): Catalog {\r\n  return catalogData as unknown as Catalog;\r\n}\r\n\r\nexport default async function importKm43({ container }: ExecArgs) {\r\n  const logger = container.resolve(ContainerRegistrationKeys.LOGGER);\r\n  const query = container.resolve(ContainerRegistrationKeys.QUERY);\r\n  const storeService = container.resolve(Modules.STORE);\r\n  const fulfillmentService = container.resolve(Modules.FULFILLMENT);\r\n\r\n  const imageBase = (process.env.KM43_IMAGE_BASE_URL || \"\").replace(/\\/$/, \"\");\r\n  if (!/^https?:\\/\\//.test(imageBase)) {\r\n    throw new MedusaError(MedusaError.Types.UNEXPECTED_STATE, \"Falta KM43_IMAGE_BASE_URL (ej. http://localhost:3000 o https://<dominio de la web>)\")",[1632,4681],", MedusaError } from \"@medusajs/framework/utils\";\r\nimport {\r\n  batchVariantImagesWorkflow,\r\n  createCollectionsWorkflow,\r\n  createInventoryLevelsWorkflow,\r\n  createProductCategoriesWorkflow,\r\n  createProductsWorkflow,\r\n  createProductTagsWorkflow,\r\n  createProductTypesWorkflow,\r\n  deleteProductsWorkflow,\r\n} from \"@medusajs/medusa/core-flows\";\r\n\r\nconst SOURCE = \"catalogo-km43\";\r\n\r\ntype CatalogVariant = { options: Record<string, string>; stock: number; images: string[] };\r\ntype CatalogProduct = {\r\n  handle: string;\r\n  title: string;\r\n  collection: string | null;\r\n  category: string | null;\r\n  tag: string | null;\r\n  price: number | null;\r\n  description: string;\r\n  details: string;\r\n  care: string;\r\n  options: Record<string, string[]>;\r\n  colors: Record<string, string>;\r\n  variants: CatalogVariant[];\r\n  images: string[];\r\n  thumbnail: string | null;\r\n};\r\ntype Catalog = {\r\n  fuente: string;\r\n  generado: string;\r\n  tipo?: string;\r\n  colecciones: { title: string; handle: string }[];\r\n  productos: CatalogProduct[];\r\n};\r\n\r\nconst sku = (...parts: string[]) =>\r\n  parts\r\n    .join(\"-\")\r\n    .normalize(\"NFD\")\r\n    .replace(/\\p{M}/gu, \"\") // quita acentos (marcas combinantes tras NFD)\r\n    .toUpperCase()\r\n    .replace(/[^A-Z0-9]+/g, \"-\")\r\n    .replace(/(^-|-$)/g, \"\");\r\n\r\nfunction loadCatalog(): Catalog {\r\n  return catalogData as unknown as Catalog;\r\n}\r\n\r\nexport default async function importKm43({ container }: ExecArgs) {\r\n  const logger = container.resolve(ContainerRegistrationKeys.LOGGER);\r\n  const query = container.resolve(ContainerRegistrationKeys.QUERY);\r\n  const storeService = container.resolve(Modules.STORE);\r\n  const fulfillmentService = container.resolve(Modules.FULFILLMENT);\r\n\r\n  const imageBase = (process.env.KM43_IMAGE_BASE_URL || \"\").replace(/\\/$/, \"\");\r\n  if (!/^https?:\\/\\//.test(imageBase)) {\r\n    throw new Error(\"Falta KM43_IMAGE_BASE_URL (ej. http://localhost:3000 o https://<dominio de la web>)\");\r\n  }\r\n  const url = (src: string) => `${imageBase}${encodeURI(src)}`;\r\n  const removeDemo = process.env.KM43_REMOVE_DEMO === \"true\";\r\n  const replace = process.env.KM43_REPLACE === \"true\";\r\n  const prune = process.env.KM43_PRUNE === \"true\";\r\n\r\n  const catalog = loadCatalog();\r\n  logger.info(`Catálogo ${catalog.fuente} (${catalog.generado}): ${catalog.productos.length} productos`);\r\n\r\n  const find = async (entity: string, filters: Record<string, unknown>, fields: string[]) => {\r\n    const { data } = await query.graph({ entity, fields, filters } as any);\r\n    return data as any[];\r\n  };\r\n\r\n  // 1) Infraestructura que deja seed-km46.ts\r\n  const [store] = await storeService.listStores();\r\n  const salesChannelId = store?.default_sales_channel_id;\r\n  const locationId = store?.default_location_id;\r\n  const [shippingProfile] = await fulfillmentService.listShippingProfiles({ type: \"default\" });\r\n  if (!salesChannelId || !locationId || !shippingProfile) {\r\n    throw new MedusaError(MedusaError.Types.UNEXPECTED_STATE, \"La tienda no tiene canal de ventas, ubicación de stock o perfil de envío. Corre primero: npx medusa exec ./src/scripts/seed-km46.ts\")"]